FROM ubuntu:24.04

# Install curl + ca-certificates required by the opencode install script.
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl ca-certificates bash && \
    rm -rf /var/lib/apt/lists/*

# Install opencode as root into /opt/opencode and add to system PATH.
RUN curl -fsSL https://opencode.ai/install | bash

ENV PATH="/opt:${PATH}"

# Create/reuse a user at UID/GID 1000 matching the host user.
RUN (getent group 1000 > /dev/null 2>&1 || groupadd --gid 1000 appuser) && \
    (getent passwd 1000 > /dev/null 2>&1 || useradd --uid 1000 --gid 1000 --create-home --shell /bin/bash appuser)

USER 1000

WORKDIR /workspace

CMD ["bash"]
